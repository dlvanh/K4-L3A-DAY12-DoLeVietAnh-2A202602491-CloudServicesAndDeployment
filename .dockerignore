# CP2 — những thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.
# KHÔNG ignore app/, utils/, requirements.txt — image cần chúng để chạy.

# Secrets
.env
.env.*
*.pem
*.key

# Git & CI
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
*.egg-info

# Không cần trong image chạy production
tests
screenshots
nginx
*.md
grade.py
docker-compose.yml
railway.toml
render.yaml

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode
*.log
